# Target environment. All three are optional — unset, each falls back to the public demo service
# this repo was built against, so a fresh checkout runs with no configuration. Set them to point
# the same suite at a different deployment (staging, a preview build, a local server). A trailing
# slash is tolerated. Per-page UI paths are derived from UI_BASE_URL, not configured separately.
# API_BASE_URL=https://restful-booker.herokuapp.com
# UI_BASE_URL=https://demoqa.com
# GRAPHQL_BASE_URL=https://eu-central-1-shared-euc1-02.cdn.hygraph.com/content/clv6lwqu7000001w690st4vix/master

BOOKER_USERNAME=admin
USER_PASSWORD=password123

# DemoQA Book Store user (https://demoqa.com/login), separate from the restful-booker credentials
# above — created via POST /Account/v1/User since the /register UI form is reCAPTCHA-protected
# (see docs/page-knowledge/book-store-register.md).
BOOK_STORE_USERNAME=your-book-store-username
BOOK_STORE_PASSWORD=your-book-store-password

# Optional: self-healing UI locators (healwright), see README "Self-Healing UI Locators".
# SELF_HEAL and AI_PROVIDER are read by healwright itself, not by this project's code — grepping
# src/ for them finds nothing by design.
SELF_HEAL=1
# 'google' is what CI actually runs on (regression.yml), matching the Gemini AI_API_KEY below;
# healwright also accepts anthropic / openai / local, each expecting that provider's own key.
AI_PROVIDER=google
AI_API_KEY=your-api-key
AI_MODEL=your-primary-model
# Optional: retried once, for the rest of a test, if AI_MODEL's daily quota is exhausted —
# free-tier quotas are tracked per model, so a second model has its own separate allowance.
AI_MODEL_FALLBACK=your-fallback-model

# Optional: Jira context collection for red-test triage (npm run jira-triage), see README
# "Jira-Driven Red-Test Triage". Uses an Atlassian API token, not OAuth — create one at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-account-email
JIRA_API_TOKEN=your-api-token

# Optional: ai-agents personas (test-developer, locator-medic, reviewer-tests, qa-analyst), see
# README "AI Agent Personas". Normally set via `source ai-agents/profiles/cheap.env` /
# `paranoid.env` rather than by hand — listed here for what each variable does.
# cheap.env (generation): Claude (Sonnet 5, middle effort) writes first, Gemini is reserve-only
# (own quota, separate from AI_MODEL/AI_MODEL_FALLBACK above so a Gemini fallback here doesn't
# compete with healwright for the same daily allowance).
AI_AGENTS_CLAUDE_TIER=sonnet
AI_AGENTS_CLAUDE_EFFORT=medium
AI_AGENTS_MODEL=your-generation-reserve-model
AI_AGENTS_MODEL_FALLBACK=your-generation-reserve-fallback-model
AI_AGENTS_MODEL_FALLBACK_2=your-generation-reserve-fallback-model-2
AI_AGENTS_PERMISSION_MODE=acceptEdits
# Optional: give each Gemini tier its own API key (a separate Google AI Studio project = a
# separate independent 1500/day quota pool) instead of sharing one key across all tiers. Falls
# back to the next configured key, then to AI_API_KEY, if a given tier's key isn't set — see
# cli-fallback.ts's resolveGeminiApiKey(). Not required: omit these to share AI_API_KEY everywhere.
AI_AGENTS_GEMINI_API_KEY=your-tier-1-gemini-api-key
AI_AGENTS_GEMINI_API_KEY_FALLBACK=your-tier-2-gemini-api-key
AI_AGENTS_GEMINI_API_KEY_FALLBACK_2=your-tier-3-gemini-api-key
# paranoid.env (review): same provider as generation (Claude), but HIGHER effort — reviews via
# claude -p --permission-mode plan (read-only, no edits possible). A review at the same effort as
# generation defeats the point of a paranoid pass.
AI_REVIEW_CLAUDE_TIER=sonnet
AI_REVIEW_CLAUDE_EFFORT=high
# How long one gemini CLI call may run before it's killed (default 5 min). Without a timeout a
# hung CLI process blocks the whole fallback chain — see cli-fallback.ts.
# AI_AGENTS_GEMINI_TIMEOUT_MS=300000

# Optional: agent-fixer's circuit breaker (src/agent-fixer/circuit-breaker.ts). Defaults are in
# that file; set these only to widen/narrow how much autonomous merging is allowed before a human
# has to look. Any REVERTED agent-fixer commit inside the window trips it regardless of count.
# AGENT_FIXER_MAX_MERGES_PER_WINDOW=3
# AGENT_FIXER_BREAKER_WINDOW=24 hours ago   # any git --since= expression

# Optional: pr-reviewer (npm run pr-review), see README "PR Review Gate". Caps how much of a PR
# diff is sent to the model — a docs-heavy PR can otherwise fail on request size rather than on
# anything about the code. The diff is truncated (and the truncation announced in the prompt), never
# silently sampled. Reuses AI_API_KEY / AI_MODEL / AI_MODEL_FALLBACK above; no key of its own.
# PR_REVIEW_MAX_DIFF_BYTES=200000

# Set by GitHub Actions, never in a .env file — listed here only so the full inventory of what the
# code reads is in one place: CI, GITHUB_STEP_SUMMARY, GITHUB_OUTPUT, GITHUB_BASE_REF,
# GITHUB_HEAD_REF, ALLURE_REPORT_URL, GH_TOKEN, PR_NUMBER, PR_TITLE, PR_BODY.
