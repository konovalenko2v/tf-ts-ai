# Target environment. All three are optional — unset, each falls back to the public demo service
# this repo was built against, so a fresh checkout runs with no configuration. Set them to point
# the same suite at a different deployment (staging, a preview build, a local server). A trailing
# slash is tolerated. Per-page UI paths are derived from UI_BASE_URL, not configured separately.
# API_BASE_URL=https://restful-booker.herokuapp.com
# UI_BASE_URL=https://demoqa.com
# GRAPHQL_BASE_URL=https://eu-central-1-shared-euc1-02.cdn.hygraph.com/content/clv6lwqu7000001w690st4vix/master

BOOKER_USERNAME=admin
USER_PASSWORD=password123

# DemoQA Book Store user (https://demoqa.com/login), separate from the restful-booker credentials
# above — created via POST /Account/v1/User since the /register UI form is reCAPTCHA-protected
# (see docs/page-knowledge/book-store-register.md).
BOOK_STORE_USERNAME=your-book-store-username
BOOK_STORE_PASSWORD=your-book-store-password

# Optional: self-healing UI locators (healwright), see README "Self-Healing UI Locators".
# SELF_HEAL and AI_PROVIDER are read by healwright itself, not by this project's code — grepping
# src/ for them finds nothing by design.
#
# claude-only-edition: no paid ANTHROPIC_API_KEY and no Gemini key, so the only provider healwright
# can use is 'local' (Ollama, fully offline — see README "Self-Healing UI Locators" for setup and
# for which local model this repo tested well enough to recommend). CI always runs with SELF_HEAL=0
# (see regression.yml) since a GitHub-hosted runner cannot reach a local Ollama instance — this is
# local-only, run when writing/updating a test, not a CI gate.
SELF_HEAL=1
AI_PROVIDER=local
AI_MODEL=qwen3:14b

# Optional: ReportPortal reporter (see docker/reportportal/), an additional test report alongside
# the existing Allure/HTML reports. Read by @reportportal/agent-js-playwright via
# playwright.config.ts, not by this project's own code. The reporter is only added to the reporter
# array when RP_ENDPOINT is set — leave it unset to run exactly as before, with no ReportPortal
# instance required (this is the default locally and in CI).
# RP_ENDPOINT=http://localhost:8080/api/v2
# RP_API_KEY=your-reportportal-api-key
# RP_PROJECT=your-reportportal-project-name
# RP_LAUNCH=tf-ts-ai

# Optional: ai-agents personas (test-developer, locator-medic, reviewer-tests), see README
# "AI Agent Personas". Normally set via `source ai-agents/profiles/cheap.env` / `paranoid.env`
# rather than by hand — listed here for what each variable does.
# cheap.env (generation): Claude (Sonnet 5, middle effort) via the existing claude CLI subscription
# session, no separate API key. claude-only-edition: no fallback tier — if this call fails, it
# fails loud (see cli-fallback.ts).
AI_AGENTS_CLAUDE_TIER=sonnet
AI_AGENTS_CLAUDE_EFFORT=medium
AI_AGENTS_PERMISSION_MODE=acceptEdits
# paranoid.env (review): same provider as generation (Claude), but HIGHER effort — reviews via
# claude -p --permission-mode plan (read-only, no edits possible). A review at the same effort as
# generation defeats the point of a paranoid pass.
AI_REVIEW_CLAUDE_TIER=sonnet
AI_REVIEW_CLAUDE_EFFORT=high

# Optional: agent-fixer's circuit breaker (src/agent-fixer/circuit-breaker.ts). Defaults are in
# that file; set these only to widen/narrow how much autonomous merging is allowed before a human
# has to look. Any REVERTED agent-fixer commit inside the window trips it regardless of count.
# AGENT_FIXER_MAX_MERGES_PER_WINDOW=3
# AGENT_FIXER_BREAKER_WINDOW=24 hours ago   # any git --since= expression

# Optional: pr-reviewer (npm run pr-review), see README "PR Review Gate". claude-only-edition: a
# local, manual step (not a CI gate) — run it yourself before pushing/merging. Caps how much of a
# PR diff is sent to the model — a docs-heavy PR can otherwise fail on request size rather than on
# anything about the code. The diff is truncated (and the truncation announced in the prompt), never
# silently sampled. Reuses AI_REVIEW_CLAUDE_TIER/AI_REVIEW_CLAUDE_EFFORT above; no key of its own.
# PR_REVIEW_MAX_DIFF_BYTES=200000

# Set by GitHub Actions, never in a .env file — listed here only so the full inventory of what the
# code reads is in one place: CI, GITHUB_STEP_SUMMARY, GITHUB_OUTPUT, GITHUB_BASE_REF,
# GITHUB_HEAD_REF, ALLURE_REPORT_URL, GH_TOKEN, PR_NUMBER, PR_TITLE, PR_BODY.
