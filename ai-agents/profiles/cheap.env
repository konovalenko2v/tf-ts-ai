# Generation profile: 3-tier CLI fallback (Claude Sonnet 5, middle effort, primary -> Gemini
# primary -> Gemini fallback model). Used by test-developer and locator-medic (agent-fixer's AI
# layer) to actually write/edit code — read by src/ai-agents/cli-fallback.ts.
#
# Claude authenticates via the existing Claude Code CLI subscription — no separate paid API key.
# Both Gemini tiers are reserve-only (reached only if Claude itself fails), on their own quota,
# separate from healwright's AI_MODEL/AI_MODEL_FALLBACK (own free-tier daily allowance each).
#
# Source before running an ai-agents generation step, e.g.: set -a; source ai-agents/profiles/cheap.env; set +a

AI_AGENTS_CLAUDE_TIER=sonnet
AI_AGENTS_CLAUDE_EFFORT=medium

AI_AGENTS_MODEL=gemini-3.5-flash
AI_AGENTS_MODEL_FALLBACK=gemini-3.6-flash

# Generation trust: allowed to write/edit files directly (read by cli-fallback.ts's DEFAULT_PROFILE).
AI_AGENTS_PERMISSION_MODE=acceptEdits
