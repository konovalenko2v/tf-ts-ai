# Generation profile: fast, cheap 3-tier CLI fallback (Gemini primary -> Gemini fallback -> Claude
# CLI). Used by test-developer and locator-medic (agent-fixer's AI layer) to actually write/edit
# code — read by src/ai-agents/cli-fallback.ts.
#
# Two Gemini tiers on their own quota, separate from healwright's AI_MODEL/AI_MODEL_FALLBACK (own
# free-tier daily allowance each), plus a mid-tier Claude model as the last resort, authenticated
# via the existing Claude Code CLI subscription — no separate paid API key for the Claude tier.
#
# Source before running an ai-agents generation step, e.g.: set -a; source ai-agents/profiles/cheap.env; set +a

AI_AGENTS_MODEL=gemini-3.5-flash
AI_AGENTS_MODEL_FALLBACK=gemini-3.6-flash
AI_AGENTS_CLAUDE_TIER=sonnet

# Generation trust: allowed to write/edit files directly (read by cli-fallback.ts's DEFAULT_PROFILE).
AI_AGENTS_PERMISSION_MODE=acceptEdits
