# Generation profile: 4-tier CLI fallback (Claude Sonnet 5, middle effort, primary -> three Gemini
# reserve tiers). Used by test-developer and locator-medic (agent-fixer's AI layer) to actually
# write/edit code — read by src/ai-agents/cli-fallback.ts.
#
# Claude authenticates via the existing Claude Code CLI subscription — no separate paid API key.
# All three Gemini tiers are reserve-only (reached only if Claude itself fails). Each is intended
# to carry its own per-model quota — per the project owner, the Google AI Studio project this repo
# is configured against lists 1500 requests/day · 15/minute for each of gemini-3.5-flash,
# gemini-3.6-flash, and gemini-3.5-flash-lite independently (not independently re-derived here from
# a full day of traffic).
#
# That separation only holds if cli-fallback.ts's runGemini() passes a real API key to the
# `gemini` CLI as GEMINI_API_KEY (the CLI's own expected var name — it does not read AI_API_KEY on
# its own). Confirmed this was previously silently broken: without GEMINI_API_KEY set explicitly,
# the CLI falls back to a different, unkeyed auth path with a much lower, short-window limit — 429s
# recurred there within seconds regardless of which model was requested (the 429 body's `model:`
# field names the quota metric, not necessarily the actual routed model — with a real key, `-m` IS
# honored: gemini-3.5-flash/3.6-flash/3.5-flash-lite each produced distinct, correct responses).
# cli-fallback.ts now sets GEMINI_API_KEY explicitly on every gemini call and refuses to run at all
# (fail loud, not silently degrade) if no key resolves at all.
#
# Optionally, each tier can carry its OWN API key (AI_AGENTS_GEMINI_API_KEY[_FALLBACK[_2]] below,
# separate from the AI_API_KEY all three otherwise share) — a separate Google AI Studio project per
# tier gives real cross-project independence, confirmed live: tier 1's key hit its own short-window
# limit while tier 2's separate key succeeded immediately in the same run. Whether sharing ONE key
# across all three model names also keeps them on independent per-model allowances (vs. one pool
# split three ways) was not conclusively isolated — per-tier keys sidestep that question rather
# than answer it.
#
# Source before running an ai-agents generation step, e.g.: set -a; source ai-agents/profiles/cheap.env; set +a

AI_AGENTS_CLAUDE_TIER=sonnet
AI_AGENTS_CLAUDE_EFFORT=medium

AI_AGENTS_MODEL=gemini-3.5-flash
AI_AGENTS_MODEL_FALLBACK=gemini-3.6-flash
AI_AGENTS_MODEL_FALLBACK_2=gemini-3.5-flash-lite

# Optional, set in .env (not here — these are real secrets, this file is committed): a distinct
# API key per Gemini tier. Unset tiers fall back to the previous tier's key, then AI_API_KEY.
# AI_AGENTS_GEMINI_API_KEY=...
# AI_AGENTS_GEMINI_API_KEY_FALLBACK=...
# AI_AGENTS_GEMINI_API_KEY_FALLBACK_2=...

# Generation trust: allowed to write/edit files directly (read by cli-fallback.ts's DEFAULT_PROFILE).
AI_AGENTS_PERMISSION_MODE=acceptEdits
